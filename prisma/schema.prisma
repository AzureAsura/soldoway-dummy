generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String       @id // Privy user ID
  wallet_address String       @unique
  email          String?
  role           Role
  created_at     DateTime     @default(now())
  tasks          Task[]       @relation("BusinessTasks")
  meetings       Meeting[]
  payouts        Payout[]
  withdrawals    Withdrawal[]
}

enum Role {
  BUSINESS
  SALES
}

model Task {
  id            String       @id @default(cuid())
  business_id   String
  business      User         @relation("BusinessTasks", fields: [business_id], references: [id])
  title         String
  description   String?
  reward_amount Float // per meeting, dalam SOL
  budget_total  Float // total deposit SOL
  budget_used   Float        @default(0)
  escrow_pda    String // address PDA on-chain
  status        TaskStatus   @default(ACTIVE)
  created_at    DateTime     @default(now())
  meetings      Meeting[]
  withdrawals   Withdrawal[]
}

enum TaskStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

model Meeting {
  id                String        @id @default(cuid())
  task_id           String
  task              Task          @relation(fields: [task_id], references: [id])
  sales_id          String
  sales             User          @relation(fields: [sales_id], references: [id])
  prospect_name     String
  scheduled_at      DateTime
  calendar_event_id String? // dari Cal.com / Google Calendar
  outcome           Outcome?
  notes             String?
  status            MeetingStatus @default(PENDING)
  created_at        DateTime      @default(now())
  payout            Payout?
}

enum MeetingStatus {
  PENDING
  CONFIRMED
  DONE
  REJECTED
}

enum Outcome {
  PRODUCTIVE
  NOT_PRODUCTIVE
}

model Payout {
  id           String       @id @default(cuid())
  meeting_id   String       @unique
  meeting      Meeting      @relation(fields: [meeting_id], references: [id])
  sales_id     String
  sales        User         @relation(fields: [sales_id], references: [id])
  amount       Float
  tx_signature String
  status       PayoutStatus @default(PENDING)
  created_at   DateTime     @default(now())
}

enum PayoutStatus {
  PENDING
  SUCCESS
  FAILED
}

model Withdrawal {
  id           String   @id @default(cuid())
  task_id      String
  task         Task     @relation(fields: [task_id], references: [id])
  business_id  String
  business     User     @relation(fields: [business_id], references: [id])
  amount       Float
  tx_signature String
  created_at   DateTime @default(now())
}
