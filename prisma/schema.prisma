generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id             String       @id              // Privy user ID (did:privy:...)
  wallet_address String       @unique
  email          String?
  role           Role
  created_at     DateTime     @default(now())
  campaigns      Campaign[]   @relation("BusinessCampaigns")
  meetings       Meeting[]
  payouts        Payout[]
  withdrawals    Withdrawal[]
}

enum Role {
  BUSINESS
  SALES
}

// ─── Campaigns ────────────────────────────────────────────────────────────────

model Campaign {
  id               String         @id @default(cuid())
  business_id      String
  business         User           @relation("BusinessCampaigns", fields: [business_id], references: [id])
  title            String
  company          String
  category         String
  description      String?
  reward_per_meeting Float                          // SOL per approved meeting
  meeting_capacity  Int                             // Max meetings allowed
  meetings_used     Int           @default(0)       // Auto-increments on approval
  budget_total      Float                           // Total SOL deposited
  budget_used       Float         @default(0)       // SOL paid out so far
  escrow_pda        String                          // On-chain PDA address
  tx_signature      String?                         // createCampaign tx hash
  status            CampaignStatus @default(ACTIVE)
  deposit_timestamp DateTime       @default(now())  // For yield mock calculation
  created_at        DateTime       @default(now())
  meetings          Meeting[]
  withdrawals       Withdrawal[]
}

enum CampaignStatus {
  ACTIVE
  CLOSED     // When meetings_used >= meeting_capacity
  WITHDRAWN  // When business withdraws remaining funds
}

// ─── Meetings ─────────────────────────────────────────────────────────────────

model Meeting {
  id               String        @id @default(cuid())
  campaign_id      String
  campaign         Campaign      @relation(fields: [campaign_id], references: [id])
  sales_id         String
  sales            User          @relation(fields: [sales_id], references: [id])
  prospect_name    String
  prospect_contact String                            // Phone or email
  scheduled_at     DateTime
  calendar_event_id String?
  notes            String?
  outcome          Outcome?
  status           MeetingStatus @default(PENDING)
  created_at       DateTime      @default(now())
  payout           Payout?
}

enum MeetingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Outcome {
  PRODUCTIVE
  NOT_PRODUCTIVE
}

// ─── Payouts ──────────────────────────────────────────────────────────────────

model Payout {
  id           String       @id @default(cuid())
  meeting_id   String       @unique
  meeting      Meeting      @relation(fields: [meeting_id], references: [id])
  sales_id     String
  sales        User         @relation(fields: [sales_id], references: [id])
  amount       Float
  tx_signature String
  status       PayoutStatus @default(PENDING)
  created_at   DateTime     @default(now())
}

enum PayoutStatus {
  PENDING
  SUCCESS
  FAILED
}

// ─── Withdrawals ──────────────────────────────────────────────────────────────

model Withdrawal {
  id           String   @id @default(cuid())
  campaign_id  String
  campaign     Campaign @relation(fields: [campaign_id], references: [id])
  business_id  String
  business     User     @relation(fields: [business_id], references: [id])
  amount       Float
  tx_signature String
  created_at   DateTime @default(now())
}
